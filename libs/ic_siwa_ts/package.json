{
  "name": "ic-siwa",
  "version": "0.1.1",
  "description": "Sign in with Avalanche for the Internet Computer",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./astro": {
      "import": "./src/astro/LoginButton.astro",
      "types": "./dist/astro/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src/astro",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "eslint src",
    "format": "prettier --write src",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "bun run build"
  },
  "keywords": [
    "icp",
    "internet-computer",
    "avalanche",
    "siwa",
    "authentication",
    "web3",
    "wallet"
  ],
  "author": "Irken Empire <dev@irkenempire.tech>",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/irken-empire/ic-siwa"
  },
  "dependencies": {
    "@dfinity/agent": "3.4.3",
    "@dfinity/candid": "3.4.3",
    "@dfinity/identity": "3.4.3",
    "@dfinity/principal": "3.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "typescript": "5.9.3",
    "prettier": "3.8.1",
    "eslint": "9.39.2"
  },
  "peerDependencies": {
    "viem": "2.45.1"
  }
}
