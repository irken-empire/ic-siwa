---
/**
 * IC-SIWA Test Canister - Login Page
 *
 * Features:
 * - Reown AppKit for WalletConnect and wallet management
 * - EIP-6963 multi-wallet detection (via AppKit)
 * - Avalanche Fuji network support
 * - SIWA authentication flow
 */
import "../styles/global.css";

// Configuration from environment
const SIWA_PROVIDER_CANISTER_ID = import.meta.env.PUBLIC_SIWA_PROVIDER_CANISTER_ID || "be2us-64aaa-aaaaa-qaabq-cai";
const IC_HOST = import.meta.env.PUBLIC_IC_HOST || "http://127.0.0.1:5987";
const WALLETCONNECT_PROJECT_ID = import.meta.env.PUBLIC_WALLETCONNECT_PROJECT_ID || "";

// Avalanche Fuji configuration
const EXPECTED_CHAIN_ID = 43113;
const CHAIN_NAME = "Avalanche Fuji";
const RPC_URL = "https://api.avax-test.network/ext/bc/C/rpc";
const BLOCK_EXPLORER = "https://testnet.snowtrace.io";

const title = "IC-SIWA Test";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="navbar bg-base-100 shadow-lg">
      <div class="flex-1">
        <a class="btn btn-ghost text-xl">IC-SIWA Test</a>
      </div>
      <div class="flex-none gap-2">
        <span id="network-badge" class="badge badge-warning">Checking...</span>
        <span class="badge badge-outline">Development</span>
      </div>
    </div>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
      <div class="flex flex-col items-center justify-center">

        <!-- Login Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <h1 class="card-title text-2xl mb-2">Sign in with Avalanche</h1>
            <p class="text-base-content/70 mb-6">
              Test the IC-SIWA authentication flow
            </p>

            <!-- Wallet Connection -->
            <div id="wallet-selection" class="w-full">
              <!-- AppKit Connect Button -->
              <div class="mb-4">
                <button id="connect-btn" class="btn btn-primary btn-block gap-3">
                  <svg viewBox="0 0 40 40" class="w-6 h-6">
                    <rect width="40" height="40" rx="8" fill="#3B99FC"/>
                    <path d="M12.3 16c4.3-4.2 11.1-4.2 15.4 0l.5.5-2 2-.3-.3c-3-2.9-7.8-2.9-10.8 0l-.3.3-2-2 .5-.5zm19 3.5l1.8 1.8-8.2 8-5.8-5.7 2-2 3.8 3.7 6.4-5.8zm-22.6 0l6.4 5.8 3.8-3.7 2 2-5.8 5.7-8.2-8 1.8-1.8z" fill="#fff"/>
                  </svg>
                  <span>Connect Wallet</span>
                </button>
              </div>

              <p class="text-xs text-base-content/50 text-center">
                  Supports multiple wallet types include Browser Injected and Wallet Connect.
              </p>
            </div>

            <!-- Loading State -->
            <div id="loading-state" class="hidden w-full">
              <div class="flex flex-col items-center">
                <span class="loading loading-spinner loading-lg"></span>
                <p id="loading-message" class="mt-2 text-base-content/70">Connecting...</p>
              </div>
            </div>

            <!-- Network Switch -->
            <div id="network-switch-state" class="hidden w-full">
              <div class="alert alert-warning mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <div>
                  <h3 class="font-bold">Wrong Network</h3>
                  <div class="text-xs">Current: <span id="current-chain-name">Unknown</span></div>
                  <div class="text-xs">Expected: {CHAIN_NAME} ({EXPECTED_CHAIN_ID})</div>
                </div>
              </div>
              <button id="switch-network-btn" class="btn btn-warning btn-wide">
                Switch to {CHAIN_NAME}
              </button>
            </div>

            <!-- SIWA Login State -->
            <div id="siwa-login-state" class="hidden w-full">
              <div class="alert alert-info mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <h3 class="font-bold">Wallet Connected</h3>
                  <div class="text-xs break-all" id="connected-address"></div>
                </div>
              </div>
              <button id="siwa-login-btn" class="btn btn-primary btn-wide">
                Sign in with Avalanche
              </button>
            </div>

            <!-- Authenticated State -->
            <div id="authenticated-state" class="hidden w-full">
              <div class="alert alert-success mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <h3 class="font-bold">Authenticated!</h3>
                  <div class="text-xs break-all" id="principal-display"></div>
                </div>
              </div>
              <div class="stats shadow w-full mb-4">
                <div class="stat">
                  <div class="stat-title">Avalanche Address</div>
                  <div class="stat-value text-sm font-mono break-all" id="address-display"></div>
                </div>
              </div>
              <button id="logout-btn" class="btn btn-outline btn-wide">Disconnect</button>
            </div>

            <!-- Error State -->
            <div id="error-state" class="hidden w-full mt-4">
              <div class="alert alert-error">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="flex-1">
                  <span id="error-message"></span>
                </div>
                <div class="flex gap-1">
                  <button id="retry-btn" class="btn btn-xs btn-ghost">Retry</button>
                  <button id="dismiss-error-btn" class="btn btn-xs btn-ghost">Dismiss</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Diagnostics Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl mt-4">
          <div class="card-body">
            <h2 class="card-title text-lg">
              Diagnostics
              <button id="refresh-diagnostics" class="btn btn-xs btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </button>
            </h2>
            <div class="overflow-x-auto">
              <table class="table table-xs">
                <tbody>
                  <tr>
                    <td class="font-semibold">Provider Canister</td>
                    <td class="font-mono text-xs break-all">{SIWA_PROVIDER_CANISTER_ID}</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">IC Host</td>
                    <td class="font-mono text-xs">{IC_HOST}</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Expected Chain</td>
                    <td class="font-mono text-xs">{EXPECTED_CHAIN_ID} ({CHAIN_NAME})</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">AppKit Status</td>
                    <td id="diag-appkit" class="font-mono text-xs">Initializing...</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Current Chain</td>
                    <td id="diag-chain" class="font-mono text-xs">-</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Connected Address</td>
                    <td id="diag-address" class="font-mono text-xs break-all">-</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="mt-4 flex gap-2">
              <button id="export-logs-btn" class="btn btn-xs btn-outline flex-1">Export Logs</button>
              <button id="clear-logs-btn" class="btn btn-xs btn-ghost">Clear</button>
            </div>
          </div>
        </div>

        <!-- Help Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl mt-4">
          <div class="collapse collapse-arrow">
            <input type="checkbox" />
            <div class="collapse-title font-medium">Troubleshooting</div>
            <div class="collapse-content text-sm">
              <ul class="list-disc pl-4 space-y-2">
                <li><strong>No wallets:</strong> Install MetaMask, Core, Rabby, or Brave Wallet</li>
                <li><strong>Wrong network:</strong> Click "Switch Network" to add Avalanche Fuji</li>
                <li><strong>WalletConnect:</strong> Scan QR with mobile wallet (Trust, Rainbow, etc.)</li>
                <li><strong>Debug:</strong> Open browser console (F12) to see detailed logs</li>
                <li><strong>URL format:</strong> Use subdomain URLs (e.g., canister-id.localhost:5987) for AppKit</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer footer-center p-4 bg-base-300 text-base-content mt-8">
      <p>IC-SIWA Test Canister - Development Only</p>
    </footer>

    <!-- Config data -->
    <div id="config"
      data-canister-id={SIWA_PROVIDER_CANISTER_ID}
      data-host={IC_HOST}
      data-chain-id={EXPECTED_CHAIN_ID}
      data-chain-name={CHAIN_NAME}
      data-rpc-url={RPC_URL}
      data-block-explorer={BLOCK_EXPLORER}
      data-walletconnect-project-id={WALLETCONNECT_PROJECT_ID}
      class="hidden"
    ></div>

    <script>
      // Reown AppKit with Wagmi Adapter
      import { createAppKit, type AppKit } from "@reown/appkit";
      import { WagmiAdapter } from "@reown/appkit-adapter-wagmi";
      import { defineChain } from "@reown/appkit/networks";

      // Wagmi Core (headless, no React)
      import { signMessage, getAccount, getChainId, switchChain, watchAccount, watchChainId, type Config } from "@wagmi/core";

      // IC-SIWA client
      import { SiwaClient } from "ic-siwa";

      // Local modules
      import { createLogger, exportAllLogs } from "../lib/logger";

      // Logger
      const log = createLogger("APP");

      // ============================================================
      // Configuration
      // ============================================================

      const configEl = document.getElementById("config");
      const config = {
        canisterId: configEl?.dataset.canisterId || "",
        host: configEl?.dataset.host || "https://ic0.app",
        chainId: parseInt(configEl?.dataset.chainId || "43113"),
        chainName: configEl?.dataset.chainName || "Avalanche Fuji",
        rpcUrl: configEl?.dataset.rpcUrl || "",
        blockExplorer: configEl?.dataset.blockExplorer || "",
        walletConnectProjectId: configEl?.dataset.walletconnectProjectId || "",
      };

      log.info("Config loaded", config);

      // ============================================================
      // Define Avalanche Fuji network for AppKit
      // ============================================================

      const avalancheFujiNetwork = defineChain({
        id: 43113,
        caipNetworkId: "eip155:43113",
        chainNamespace: "eip155",
        name: "Avalanche Fuji",
        nativeCurrency: {
          decimals: 18,
          name: "AVAX",
          symbol: "AVAX",
        },
        rpcUrls: {
          default: {
            http: ["https://api.avax-test.network/ext/bc/C/rpc"],
          },
        },
        blockExplorers: {
          default: { name: "Snowtrace", url: "https://testnet.snowtrace.io" },
        },
      });

      // ============================================================
      // State
      // ============================================================

      interface AppState {
        appKit: AppKit | null;
        wagmiConfig: Config | null;
        address: string | null;
        chainId: number | null;
        isConnected: boolean;
        isAuthenticated: boolean;
        principal: string | null;
      }

      const state: AppState = {
        appKit: null,
        wagmiConfig: null,
        address: null,
        chainId: null,
        isConnected: false,
        isAuthenticated: false,
        principal: null,
      };

      // SIWA client
      const siwaClient = new SiwaClient({
        canisterId: config.canisterId,
        host: config.host,
      });

      // ============================================================
      // UI Elements
      // ============================================================

      const ui = {
        walletSelection: document.getElementById("wallet-selection"),
        connectBtn: document.getElementById("connect-btn"),
        loadingState: document.getElementById("loading-state"),
        loadingMessage: document.getElementById("loading-message"),
        networkSwitchState: document.getElementById("network-switch-state"),
        switchNetworkBtn: document.getElementById("switch-network-btn"),
        currentChainName: document.getElementById("current-chain-name"),
        siwaLoginState: document.getElementById("siwa-login-state"),
        siwaLoginBtn: document.getElementById("siwa-login-btn"),
        connectedAddress: document.getElementById("connected-address"),
        authenticatedState: document.getElementById("authenticated-state"),
        principalDisplay: document.getElementById("principal-display"),
        addressDisplay: document.getElementById("address-display"),
        logoutBtn: document.getElementById("logout-btn"),
        errorState: document.getElementById("error-state"),
        errorMessage: document.getElementById("error-message"),
        retryBtn: document.getElementById("retry-btn"),
        dismissErrorBtn: document.getElementById("dismiss-error-btn"),
        networkBadge: document.getElementById("network-badge"),
        diagAppKit: document.getElementById("diag-appkit"),
        diagChain: document.getElementById("diag-chain"),
        diagAddress: document.getElementById("diag-address"),
        refreshDiagnostics: document.getElementById("refresh-diagnostics"),
        exportLogsBtn: document.getElementById("export-logs-btn"),
        clearLogsBtn: document.getElementById("clear-logs-btn"),
      };

      // ============================================================
      // UI State Management
      // ============================================================

      type UIState = "wallets" | "loading" | "network-switch" | "siwa-login" | "authenticated" | "error";

      function showUIState(stateName: UIState, message?: string): void {
        log.debug(`UI state: ${stateName}`, { message });

        ui.walletSelection?.classList.toggle("hidden", stateName !== "wallets");
        ui.loadingState?.classList.toggle("hidden", stateName !== "loading");
        ui.networkSwitchState?.classList.toggle("hidden", stateName !== "network-switch");
        ui.siwaLoginState?.classList.toggle("hidden", stateName !== "siwa-login");
        ui.authenticatedState?.classList.toggle("hidden", stateName !== "authenticated");
        ui.errorState?.classList.toggle("hidden", stateName !== "error");

        if (stateName === "loading" && ui.loadingMessage && message) {
          ui.loadingMessage.textContent = message;
        }
        if (stateName === "error" && ui.errorMessage && message) {
          ui.errorMessage.textContent = message;
        }
      }

      function updateNetworkBadge(): void {
        if (!ui.networkBadge) return;

        if (state.chainId === null) {
          ui.networkBadge.className = "badge badge-warning";
          ui.networkBadge.textContent = "No Wallet";
        } else if (state.chainId === config.chainId) {
          ui.networkBadge.className = "badge badge-success";
          ui.networkBadge.textContent = config.chainName;
        } else {
          ui.networkBadge.className = "badge badge-error";
          ui.networkBadge.textContent = `Chain ${state.chainId}`;
        }
      }

      function updateDiagnostics(): void {
        if (ui.diagAppKit) {
          ui.diagAppKit.textContent = state.appKit ? (state.isConnected ? "Connected" : "Ready") : "Initializing...";
        }
        if (ui.diagChain) {
          ui.diagChain.textContent = state.chainId
            ? `${state.chainId} (0x${state.chainId.toString(16)})`
            : "-";
        }
        if (ui.diagAddress) {
          ui.diagAddress.textContent = state.address || "-";
        }

        updateNetworkBadge();
      }

      // ============================================================
      // AppKit Initialization with WagmiAdapter
      // ============================================================

      async function initAppKit(): Promise<void> {
        log.info("Initializing AppKit with WagmiAdapter");

        if (!config.walletConnectProjectId) {
          log.error("WalletConnect Project ID not configured");
          if (ui.diagAppKit) ui.diagAppKit.textContent = "Error: No Project ID";
          showUIState("error", "WalletConnect is not configured. Please set PUBLIC_WALLETCONNECT_PROJECT_ID.");
          return;
        }

        try {
          // Create Wagmi adapter (provides wagmiConfig for @wagmi/core actions)
          const wagmiAdapter = new WagmiAdapter({
            projectId: config.walletConnectProjectId,
            networks: [avalancheFujiNetwork],
          });

          // Store wagmiConfig for use with @wagmi/core actions
          state.wagmiConfig = wagmiAdapter.wagmiConfig;

          // Create AppKit instance with WagmiAdapter
          const appKit = createAppKit({
            adapters: [wagmiAdapter],
            projectId: config.walletConnectProjectId,
            networks: [avalancheFujiNetwork],
            metadata: {
              name: "IC-SIWA Test",
              description: "Sign in with Avalanche for Internet Computer",
              url: window.location.origin,
              icons: [`${window.location.origin}/favicon.svg`],
            },
            themeMode: "dark",
            // Provide network images to prevent SVG rendering errors
            chainImages: {
              43113: "https://raw.githubusercontent.com/ava-labs/avalanche-docs/main/static/img/Avalanche_Horizontal_Red.svg",
            },
          });

          state.appKit = appKit;
          log.info("AppKit initialized with WagmiAdapter");

          // Use wagmi core's watchAccount to track connection state
          const unwatchAccount = watchAccount(state.wagmiConfig, {
            onChange: (account) => {
              log.debug("Account state changed", {
                address: account.address,
                chainId: account.chainId,
                isConnected: account.isConnected
              });

              state.address = account.address || null;
              state.chainId = account.chainId || null;
              state.isConnected = account.isConnected;

              updateDiagnostics();
              handleConnectionState();
            }
          });

          // Also watch for chain changes
          const unwatchChainId = watchChainId(state.wagmiConfig, {
            onChange: (chainId) => {
              log.debug("Chain changed", { chainId });
              state.chainId = chainId;
              updateDiagnostics();
              handleConnectionState();
            }
          });

          // Clean up watchers on page unload to prevent memory leaks
          window.addEventListener("beforeunload", () => {
            unwatchAccount();
            unwatchChainId();
          });

          // Get initial state
          const initialAccount = getAccount(state.wagmiConfig);
          state.address = initialAccount.address || null;
          state.chainId = initialAccount.chainId || null;
          state.isConnected = initialAccount.isConnected;

          updateDiagnostics();

        } catch (error) {
          log.error("AppKit initialization failed", error);
          if (ui.diagAppKit) ui.diagAppKit.textContent = "Error: Init failed";
          showUIState("error", error instanceof Error ? error.message : "Failed to initialize wallet connection");
        }
      }

      // ============================================================
      // Connection State Handler
      // ============================================================

      function handleConnectionState(): void {
        if (!state.isConnected || !state.address) {
          // Not connected - show wallet selection
          showUIState("wallets");
          return;
        }

        // Connected - check chain
        if (state.chainId !== config.chainId) {
          log.warn(`Wrong network: ${state.chainId}, expected ${config.chainId}`);
          if (ui.currentChainName) ui.currentChainName.textContent = `Chain ${state.chainId}`;
          showUIState("network-switch");
          return;
        }

        // Correct chain - check if already authenticated
        if (state.isAuthenticated && state.principal) {
          if (ui.principalDisplay) ui.principalDisplay.textContent = state.principal;
          if (ui.addressDisplay) ui.addressDisplay.textContent = state.address;
          showUIState("authenticated");
          return;
        }

        // Ready for SIWA login
        if (ui.connectedAddress) ui.connectedAddress.textContent = state.address;
        showUIState("siwa-login");
      }

      // ============================================================
      // Wallet Connection
      // ============================================================

      async function handleConnect(): Promise<void> {
        if (!state.appKit) {
          showUIState("error", "Wallet connection not initialized");
          return;
        }

        log.info("Opening wallet modal");
        state.appKit.open();
      }

      // ============================================================
      // Network Switching
      // ============================================================

      async function handleNetworkSwitch(): Promise<void> {
        if (!state.wagmiConfig) {
          showUIState("error", "Wallet connection not initialized");
          return;
        }

        log.info("Switching network via wagmi core");
        showUIState("loading", "Switching network...");

        try {
          // Use @wagmi/core switchChain action
          await switchChain(state.wagmiConfig, { chainId: config.chainId });
          log.info("Network switch requested");

          // The subscribeProvider callback will handle the state update

        } catch (error) {
          log.error("Network switch error", error);
          showUIState("error", error instanceof Error ? error.message : "Network switch failed");
        }
      }

      // ============================================================
      // SIWA Login
      // ============================================================

      async function performSiwaLogin(): Promise<void> {
        if (!state.wagmiConfig || !state.address) {
          throw new Error("No wallet connected");
        }

        log.info("Starting SIWA login", { address: state.address });
        showUIState("loading", "Preparing login...");

        try {
          // Prepare login message
          const prepared = await siwaClient.prepareLogin(state.address);
          log.debug("Login prepared", { message: prepared.message.substring(0, 50) + "..." });

          showUIState("loading", "Please sign the message...");

          // Sign using @wagmi/core signMessage action
          const signature = await signMessage(state.wagmiConfig, {
            message: prepared.message,
          });

          log.debug("Signature received");
          showUIState("loading", "Completing authentication...");

          // Complete login
          const result = await siwaClient.login(signature, state.address);
          log.info("Login successful", { principal: result.principal.toText() });

          state.isAuthenticated = true;
          state.principal = result.principal.toText();

          // Update UI
          if (ui.principalDisplay) ui.principalDisplay.textContent = state.principal;
          if (ui.addressDisplay) ui.addressDisplay.textContent = state.address;

          showUIState("authenticated");
          updateDiagnostics();

        } catch (error) {
          log.error("SIWA login error", error);
          showUIState("error", error instanceof Error ? error.message : "Login failed");
        }
      }

      // ============================================================
      // Logout
      // ============================================================

      async function handleLogout(): Promise<void> {
        log.info("Logging out");

        try {
          await siwaClient.logout();
        } catch (e) {
          log.warn("Logout error (ignored)", e);
        }

        // Disconnect AppKit
        if (state.appKit) {
          try {
            await state.appKit.disconnect();
          } catch (e) {
            log.warn("AppKit disconnect error (ignored)", e);
          }
        }

        // Reset state (keep wagmiConfig as it's tied to the adapter)
        state.address = null;
        state.chainId = null;
        state.isConnected = false;
        state.isAuthenticated = false;
        state.principal = null;

        showUIState("wallets");
        updateDiagnostics();
      }

      // ============================================================
      // Check Existing Auth
      // ============================================================

      async function checkExistingAuth(): Promise<void> {
        try {
          if (await siwaClient.isAuthenticated()) {
            log.info("User already authenticated");
            const principal = await siwaClient.getPrincipal();
            const address = await siwaClient.getAddress();

            state.isAuthenticated = true;
            state.principal = principal?.toText() || null;
            // Note: address from siwaClient may differ from current wallet

            if (state.isConnected && state.address) {
              if (ui.principalDisplay) ui.principalDisplay.textContent = state.principal || "";
              if (ui.addressDisplay) ui.addressDisplay.textContent = state.address;
              showUIState("authenticated");
            }
          }
        } catch (e) {
          log.debug("Not authenticated", e);
        }
      }

      // ============================================================
      // Event Listeners
      // ============================================================

      ui.connectBtn?.addEventListener("click", handleConnect);
      ui.switchNetworkBtn?.addEventListener("click", handleNetworkSwitch);
      ui.siwaLoginBtn?.addEventListener("click", performSiwaLogin);
      ui.logoutBtn?.addEventListener("click", handleLogout);
      ui.retryBtn?.addEventListener("click", () => showUIState("wallets"));
      ui.dismissErrorBtn?.addEventListener("click", () => showUIState("wallets"));
      ui.refreshDiagnostics?.addEventListener("click", updateDiagnostics);

      ui.exportLogsBtn?.addEventListener("click", () => {
        const logs = exportAllLogs();
        const blob = new Blob([logs], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `ic-siwa-logs-${Date.now()}.json`;
        a.click();
        URL.revokeObjectURL(url);
      });

      ui.clearLogsBtn?.addEventListener("click", () => {
        log.info("Logs cleared");
      });

      // ============================================================
      // Initialize
      // ============================================================

      async function init(): Promise<void> {
        log.info("Initializing app");

        // Initialize AppKit
        await initAppKit();

        // Check existing auth
        await checkExistingAuth();

        log.info("Initialization complete");
      }

      init();
    </script>
  </body>
</html>
