---
/**
 * IC-SIWA Test Canister - Enhanced Login Page
 *
 * Features:
 * - EIP-6963 multi-wallet detection (MetaMask, Core, Rabby, Brave, Frame, etc.)
 * - Dedicated WalletConnect button
 * - Network switching to Avalanche Fuji
 * - Comprehensive logging and diagnostics
 */
import "../styles/global.css";

// Configuration
const SIWA_PROVIDER_CANISTER_ID = import.meta.env.PUBLIC_SIWA_PROVIDER_CANISTER_ID || "be2us-64aaa-aaaaa-qaabq-cai";
const IC_HOST = import.meta.env.PUBLIC_IC_HOST || "http://127.0.0.1:5987";

// Expected chain configuration
const EXPECTED_CHAIN_ID = 43113; // Avalanche Fuji
const CHAIN_NAME = "Avalanche Fuji";
const RPC_URL = "https://api.avax-test.network/ext/bc/C/rpc";
const BLOCK_EXPLORER = "https://testnet.snowtrace.io";

const title = "IC-SIWA Test";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="navbar bg-base-100 shadow-lg">
      <div class="flex-1">
        <a class="btn btn-ghost text-xl">IC-SIWA Test</a>
      </div>
      <div class="flex-none gap-2">
        <span id="network-badge" class="badge badge-warning">Checking...</span>
        <span class="badge badge-outline">Development</span>
      </div>
    </div>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
      <div class="flex flex-col items-center justify-center">

        <!-- Login Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <h1 class="card-title text-2xl mb-2">Sign in with Avalanche</h1>
            <p class="text-base-content/70 mb-6">
              Test the IC-SIWA authentication flow
            </p>

            <!-- Wallet Selection -->
            <div id="wallet-selection" class="w-full">
              <!-- Injected Wallets Section -->
              <div class="mb-4">
                <p class="text-sm text-base-content/60 mb-2 text-left">Browser Wallets:</p>
                <div id="injected-wallet-list" class="flex flex-col gap-2">
                  <div class="flex justify-center py-4">
                    <span class="loading loading-dots loading-md"></span>
                  </div>
                </div>
              </div>

              <!-- Divider -->
              <div class="divider text-xs text-base-content/40">OR</div>

              <!-- WalletConnect Button -->
              <div class="mb-2">
                <button id="walletconnect-btn" class="btn btn-outline btn-block justify-start gap-3 border-[#3B99FC] hover:bg-[#3B99FC] hover:border-[#3B99FC]">
                  <svg viewBox="0 0 40 40" class="w-6 h-6">
                    <rect width="40" height="40" rx="8" fill="#3B99FC"/>
                    <path d="M12.3 16c4.3-4.2 11.1-4.2 15.4 0l.5.5-2 2-.3-.3c-3-2.9-7.8-2.9-10.8 0l-.3.3-2-2 .5-.5zm19 3.5l1.8 1.8-8.2 8-5.8-5.7 2-2 3.8 3.7 6.4-5.8zm-22.6 0l6.4 5.8 3.8-3.7 2 2-5.8 5.7-8.2-8 1.8-1.8z" fill="#fff"/>
                  </svg>
                  <span>WalletConnect</span>
                  <span class="badge badge-xs badge-ghost ml-auto">QR Code</span>
                </button>
              </div>
            </div>

            <!-- Loading State -->
            <div id="loading-state" class="hidden w-full">
              <div class="flex flex-col items-center">
                <span class="loading loading-spinner loading-lg"></span>
                <p id="loading-message" class="mt-2 text-base-content/70">Connecting...</p>
              </div>
            </div>

            <!-- Network Switch Required -->
            <div id="network-switch-state" class="hidden w-full">
              <div class="alert alert-warning mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <div>
                  <h3 class="font-bold">Wrong Network</h3>
                  <div class="text-xs">Current: <span id="current-chain-name">Unknown</span></div>
                  <div class="text-xs">Expected: {CHAIN_NAME} ({EXPECTED_CHAIN_ID})</div>
                </div>
              </div>
              <button id="switch-network-btn" class="btn btn-warning btn-wide">
                Switch to {CHAIN_NAME}
              </button>
            </div>

            <!-- Authenticated State -->
            <div id="authenticated-state" class="hidden w-full">
              <div class="alert alert-success mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <h3 class="font-bold">Connected!</h3>
                  <div class="text-xs break-all" id="principal-display"></div>
                </div>
              </div>

              <div class="stats shadow w-full mb-4">
                <div class="stat">
                  <div class="stat-title">Avalanche Address</div>
                  <div class="stat-value text-sm font-mono break-all" id="address-display"></div>
                </div>
              </div>

              <button id="logout-btn" class="btn btn-outline btn-wide">
                Disconnect
              </button>
            </div>

            <!-- Error State -->
            <div id="error-state" class="hidden w-full mt-4">
              <div class="alert alert-error">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="flex-1">
                  <span id="error-message"></span>
                </div>
                <div class="flex gap-1">
                  <button id="retry-btn" class="btn btn-xs btn-ghost">Retry</button>
                  <button id="dismiss-error-btn" class="btn btn-xs btn-ghost">Dismiss</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Configuration/Diagnostics Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl mt-4">
          <div class="card-body">
            <h2 class="card-title text-lg">
              Configuration & Diagnostics
              <button id="refresh-diagnostics" class="btn btn-xs btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </button>
            </h2>
            <div class="overflow-x-auto">
              <table class="table table-xs">
                <thead>
                  <tr><th colspan="2" class="text-primary">IC Configuration</th></tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="font-semibold">Provider Canister</td>
                    <td class="font-mono text-xs break-all">{SIWA_PROVIDER_CANISTER_ID}</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">IC Host</td>
                    <td class="font-mono text-xs">{IC_HOST}</td>
                  </tr>
                </tbody>
                <thead>
                  <tr><th colspan="2" class="text-primary pt-4">Avalanche Configuration</th></tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="font-semibold">Expected Chain ID</td>
                    <td class="font-mono text-xs">{EXPECTED_CHAIN_ID} ({CHAIN_NAME})</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">RPC URL</td>
                    <td class="font-mono text-xs break-all">{RPC_URL}</td>
                  </tr>
                </tbody>
                <thead>
                  <tr><th colspan="2" class="text-primary pt-4">Wallet Status</th></tr>
                </thead>
                <tbody id="wallet-diagnostics">
                  <tr>
                    <td class="font-semibold">Detected Wallets</td>
                    <td id="diag-wallets" class="font-mono text-xs">Scanning...</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">EIP-6963 Support</td>
                    <td id="diag-eip6963" class="font-mono text-xs">-</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Current Chain ID</td>
                    <td id="diag-chain-id" class="font-mono text-xs">-</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Connected Address</td>
                    <td id="diag-address" class="font-mono text-xs break-all">-</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Wallet Unlocked</td>
                    <td id="diag-unlocked" class="font-mono text-xs">-</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Network Match</td>
                    <td id="diag-network-match" class="font-mono text-xs">-</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Log Export Button -->
            <div class="mt-4 flex gap-2">
              <button id="export-logs-btn" class="btn btn-xs btn-outline flex-1">
                Export Logs
              </button>
              <button id="clear-logs-btn" class="btn btn-xs btn-ghost">
                Clear
              </button>
            </div>
          </div>
        </div>

        <!-- Help Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl mt-4">
          <div class="collapse collapse-arrow">
            <input type="checkbox" />
            <div class="collapse-title font-medium">
              Troubleshooting
            </div>
            <div class="collapse-content text-sm">
              <ul class="list-disc pl-4 space-y-2">
                <li><strong>No wallets detected:</strong> Install MetaMask, Core Wallet, Rabby, Brave Wallet, or Frame</li>
                <li><strong>Wallet not showing:</strong> Make sure the extension is enabled and refresh the page</li>
                <li><strong>Wrong network:</strong> Click "Switch Network" or manually add Avalanche Fuji</li>
                <li><strong>Wallet locked:</strong> Unlock your wallet and refresh</li>
                <li><strong>Using Anvil fork:</strong> Ensure Anvil is forked from Fuji (chain ID 43113)</li>
                <li><strong>Connection refused:</strong> Check IC replica is running on {IC_HOST}</li>
                <li><strong>Debug issues:</strong> Open browser console (F12) to see detailed logs</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer footer-center p-4 bg-base-300 text-base-content mt-8">
      <div>
        <p>IC-SIWA Test Canister - For development use only</p>
      </div>
    </footer>

    <!-- Hidden config for JS -->
    <div id="config"
      data-canister-id={SIWA_PROVIDER_CANISTER_ID}
      data-host={IC_HOST}
      data-expected-chain-id={EXPECTED_CHAIN_ID}
      data-chain-name={CHAIN_NAME}
      data-rpc-url={RPC_URL}
      data-block-explorer={BLOCK_EXPLORER}
      class="hidden"
    ></div>

    <script>
      import { SiwaClient } from "ic-siwa";
      import type { EIP1193Provider } from "viem";
      import { createLogger, siwaLog, uiLog, wcLog, walletLog, networkLog, eip6963Log, exportAllLogs } from "../lib/logger";
      import type { DetectedWallet, WalletState, AppConfig, ChainConfig } from "../lib/types";
      import { getWalletIcon, RPC_ERRORS, isRpcError } from "../lib/types";
      import {
        initWalletDetection,
        onWalletsChanged,
        getDetectedWallets,
        requestAccounts,
        getChainId,
        switchChain,
        signMessage,
        setupProviderListeners,
      } from "../lib/wallet-detection";

      // Initialize main logger
      const log = createLogger("MAIN");

      log.info("IC-SIWA Test Canister initializing");

      // Get configuration from data attributes
      const configEl = document.getElementById("config");
      const config: AppConfig = {
        canisterId: configEl?.dataset.canisterId || "",
        host: configEl?.dataset.host || "https://ic0.app",
        expectedChainId: parseInt(configEl?.dataset.expectedChainId || "43113"),
        chainName: configEl?.dataset.chainName || "Avalanche Fuji",
        rpcUrl: configEl?.dataset.rpcUrl || "",
        blockExplorer: configEl?.dataset.blockExplorer || "",
      };

      log.info("Configuration loaded", config);

      // Avalanche chain config for adding network
      const avalancheFujiChain: ChainConfig = {
        chainId: config.expectedChainId,
        chainName: config.chainName,
        nativeCurrency: {
          name: "AVAX",
          symbol: "AVAX",
          decimals: 18,
        },
        rpcUrls: [config.rpcUrl],
        blockExplorerUrls: [config.blockExplorer],
      };

      // State
      const state: WalletState = {
        selectedWallet: null,
        address: null,
        chainId: null,
        isUnlocked: false,
        isAuthenticated: false,
        principal: null,
      };

      // Provider cleanup function
      let cleanupProviderListeners: (() => void) | null = null;

      // UI Elements
      const walletSelection = document.getElementById("wallet-selection");
      const injectedWalletList = document.getElementById("injected-wallet-list");
      const walletConnectBtn = document.getElementById("walletconnect-btn");
      const loadingState = document.getElementById("loading-state");
      const loadingMessage = document.getElementById("loading-message");
      const networkSwitchState = document.getElementById("network-switch-state");
      const authenticatedState = document.getElementById("authenticated-state");
      const errorState = document.getElementById("error-state");
      const principalDisplay = document.getElementById("principal-display");
      const addressDisplay = document.getElementById("address-display");
      const errorMessage = document.getElementById("error-message");
      const logoutBtn = document.getElementById("logout-btn");
      const switchNetworkBtn = document.getElementById("switch-network-btn");
      const retryBtn = document.getElementById("retry-btn");
      const dismissErrorBtn = document.getElementById("dismiss-error-btn");
      const networkBadge = document.getElementById("network-badge");
      const currentChainName = document.getElementById("current-chain-name");
      const refreshDiagnostics = document.getElementById("refresh-diagnostics");
      const exportLogsBtn = document.getElementById("export-logs-btn");
      const clearLogsBtn = document.getElementById("clear-logs-btn");

      // Diagnostics elements
      const diagWallets = document.getElementById("diag-wallets");
      const diagEip6963 = document.getElementById("diag-eip6963");
      const diagChainId = document.getElementById("diag-chain-id");
      const diagAddress = document.getElementById("diag-address");
      const diagUnlocked = document.getElementById("diag-unlocked");
      const diagNetworkMatch = document.getElementById("diag-network-match");

      // Create SIWA client
      siwaLog.info("Creating SIWA client", { canisterId: config.canisterId, host: config.host });
      const client = new SiwaClient({ canisterId: config.canisterId, host: config.host });

      // Update UI state
      function showState(stateName: "wallets" | "loading" | "network-switch" | "authenticated" | "error", message?: string) {
        uiLog.debug(`Showing state: ${stateName}`, { message });

        walletSelection?.classList.toggle("hidden", stateName !== "wallets");
        loadingState?.classList.toggle("hidden", stateName !== "loading");
        networkSwitchState?.classList.toggle("hidden", stateName !== "network-switch");
        authenticatedState?.classList.toggle("hidden", stateName !== "authenticated");
        errorState?.classList.toggle("hidden", stateName !== "error");

        if (stateName === "loading" && loadingMessage && message) {
          loadingMessage.textContent = message;
        }
        if (stateName === "error" && errorMessage && message) {
          errorMessage.textContent = message;
        }
      }

      // Update network badge
      function updateNetworkBadge(chainId: number | null) {
        if (!networkBadge) return;

        if (chainId === null) {
          networkBadge.className = "badge badge-warning";
          networkBadge.textContent = "No Wallet";
        } else if (chainId === config.expectedChainId) {
          networkBadge.className = "badge badge-success";
          networkBadge.textContent = config.chainName;
        } else {
          networkBadge.className = "badge badge-error";
          networkBadge.textContent = `Chain ${chainId}`;
        }
      }

      // Update diagnostics display
      function updateDiagnostics() {
        const wallets = getDetectedWallets();

        // Wallet count
        if (diagWallets) {
          const names = wallets.map(w => w.name);
          diagWallets.textContent = names.length > 0 ? names.join(", ") : "None detected";
        }

        // EIP-6963 support
        if (diagEip6963) {
          const eip6963Count = wallets.filter(w => w.source === "eip6963").length;
          const legacyCount = wallets.filter(w => w.source === "legacy").length;
          diagEip6963.textContent = `${eip6963Count} modern, ${legacyCount} legacy`;
        }

        // Chain ID
        if (diagChainId) {
          if (state.chainId !== null) {
            diagChainId.textContent = `${state.chainId} (0x${state.chainId.toString(16)})`;
          } else {
            diagChainId.textContent = "-";
          }
        }

        // Address
        if (diagAddress) {
          diagAddress.textContent = state.address || "-";
        }

        // Unlocked
        if (diagUnlocked) {
          if (state.selectedWallet) {
            diagUnlocked.textContent = state.isUnlocked ? "Yes" : "No (locked)";
            diagUnlocked.className = `font-mono text-xs ${state.isUnlocked ? "text-success" : "text-warning"}`;
          } else {
            diagUnlocked.textContent = "-";
            diagUnlocked.className = "font-mono text-xs";
          }
        }

        // Network match
        if (diagNetworkMatch) {
          if (state.chainId !== null) {
            const match = state.chainId === config.expectedChainId;
            diagNetworkMatch.textContent = match ? "Yes" : "No";
            diagNetworkMatch.className = `font-mono text-xs ${match ? "text-success" : "text-error"}`;
          } else {
            diagNetworkMatch.textContent = "-";
            diagNetworkMatch.className = "font-mono text-xs";
          }
        }

        updateNetworkBadge(state.chainId);
      }

      // Render wallet buttons
      function renderWalletButtons(wallets: DetectedWallet[]) {
        if (!injectedWalletList) return;

        uiLog.debug("Rendering wallet buttons", { count: wallets.length });

        // Filter out walletconnect (handled separately)
        const injectedWallets = wallets.filter(w => w.source !== "walletconnect");

        if (injectedWallets.length === 0) {
          injectedWalletList.innerHTML = `
            <div class="alert alert-info text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>No browser wallets detected. Install MetaMask, Core, Rabby, or another EVM wallet.</span>
            </div>
          `;
          return;
        }

        injectedWalletList.innerHTML = injectedWallets.map(wallet => {
          // Determine how to render the icon
          // EIP-6963 icons are data URIs (data:image/...), our fallbacks are inline SVG
          const isDataUri = wallet.icon.startsWith("data:");
          const iconHtml = isDataUri
            ? `<img src="${wallet.icon}" alt="${wallet.name}" class="w-6 h-6 rounded" />`
            : `<span class="wallet-icon">${wallet.icon}</span>`;

          return `
            <button class="btn btn-outline btn-block justify-start gap-3 wallet-btn" data-wallet-id="${wallet.id}">
              ${iconHtml}
              <span class="flex-1 text-left">${wallet.name}</span>
              <span class="badge badge-xs badge-ghost">${wallet.source === "eip6963" ? "EIP-6963" : "Legacy"}</span>
            </button>
          `;
        }).join("");

        // Add click handlers
        document.querySelectorAll(".wallet-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const walletId = btn.getAttribute("data-wallet-id");
            const wallet = wallets.find(w => w.id === walletId);
            if (wallet) {
              handleWalletSelect(wallet);
            }
          });
        });

        updateDiagnostics();
      }

      // Handle wallet selection
      async function handleWalletSelect(wallet: DetectedWallet) {
        log.info(`Wallet selected: ${wallet.name}`, { id: wallet.id, source: wallet.source });

        state.selectedWallet = wallet;
        showState("loading", `Connecting to ${wallet.name}...`);

        try {
          // Setup provider listeners
          if (cleanupProviderListeners) {
            cleanupProviderListeners();
          }
          cleanupProviderListeners = setupProviderListeners(wallet.provider, {
            onAccountsChanged: (accounts) => {
              state.address = accounts[0] || null;
              state.isUnlocked = accounts.length > 0;
              updateDiagnostics();
              if (!state.isUnlocked && !state.isAuthenticated) {
                showState("wallets");
              }
            },
            onChainChanged: (chainId) => {
              state.chainId = chainId;
              updateDiagnostics();
              if (chainId !== config.expectedChainId && !state.isAuthenticated) {
                if (currentChainName) currentChainName.textContent = `Chain ${chainId}`;
                showState("network-switch");
              }
            },
          });

          // Request accounts
          showState("loading", "Requesting account access...");
          const accounts = await requestAccounts(wallet.provider);

          if (!accounts || accounts.length === 0) {
            throw new Error("No accounts available. Please unlock your wallet.");
          }

          state.address = accounts[0];
          state.isUnlocked = true;

          // Check chain ID
          showState("loading", "Checking network...");
          state.chainId = await getChainId(wallet.provider);

          updateDiagnostics();

          // If wrong network, show switch prompt
          if (state.chainId !== config.expectedChainId) {
            log.warn(`Wrong network: ${state.chainId}, expected ${config.expectedChainId}`);
            if (currentChainName) currentChainName.textContent = `Chain ${state.chainId}`;
            showState("network-switch");
            return;
          }

          // Proceed with SIWA login
          await performSiwaLogin(wallet.provider);

        } catch (error) {
          handleWalletError(error);
        }
      }

      // Handle WalletConnect
      async function handleWalletConnect() {
        wcLog.info("Initializing WalletConnect");
        showState("loading", "Initializing WalletConnect...");

        try {
          const { EthereumProvider } = await import("@walletconnect/ethereum-provider");

          wcLog.debug("Creating EthereumProvider");
          const provider = await EthereumProvider.init({
            projectId: "demo-project-id", // Replace with real project ID for production
            chains: [config.expectedChainId],
            showQrModal: true,
            qrModalOptions: {
              themeMode: "dark" as const,
            },
          });

          wcLog.info("Connecting via QR modal");
          showState("loading", "Scan QR code with your mobile wallet...");
          await provider.connect();

          wcLog.info("WalletConnect connected");

          // Create wallet object
          const wallet: DetectedWallet = {
            id: "walletconnect",
            name: "WalletConnect",
            icon: getWalletIcon("walletconnect"),
            provider: provider as unknown as EIP1193Provider,
            source: "walletconnect",
          };

          state.selectedWallet = wallet;

          // Get accounts
          const accounts = await provider.request({ method: "eth_accounts" }) as string[];
          if (!accounts || accounts.length === 0) {
            throw new Error("No accounts available from WalletConnect");
          }

          state.address = accounts[0];
          state.isUnlocked = true;

          // Get chain ID
          const chainIdHex = await provider.request({ method: "eth_chainId" }) as string;
          state.chainId = parseInt(chainIdHex, 16);

          updateDiagnostics();

          // Check network
          if (state.chainId !== config.expectedChainId) {
            wcLog.warn(`Wrong network: ${state.chainId}`);
            if (currentChainName) currentChainName.textContent = `Chain ${state.chainId}`;
            showState("network-switch");
            return;
          }

          // Proceed with SIWA login
          await performSiwaLogin(provider as unknown as EIP1193Provider);

        } catch (error) {
          wcLog.error("WalletConnect error", error);
          handleWalletError(error);
        }
      }

      // Handle wallet errors
      function handleWalletError(error: unknown) {
        log.error("Wallet error", error);

        let message = "An error occurred";

        if (isRpcError(error)) {
          switch (error.code) {
            case RPC_ERRORS.USER_REJECTED:
              message = "Connection rejected by user";
              break;
            case RPC_ERRORS.PENDING_REQUEST:
              message = "Please check your wallet - a request is pending";
              break;
            case RPC_ERRORS.UNAUTHORIZED:
              message = "Wallet is locked. Please unlock and try again.";
              break;
            default:
              message = error.message || "Wallet error";
          }
        } else if (error instanceof Error) {
          message = error.message;
        }

        showState("error", message);
        updateDiagnostics();
      }

      // Switch network
      async function handleNetworkSwitch() {
        if (!state.selectedWallet?.provider) {
          showState("error", "No wallet connected");
          return;
        }

        log.info("Switching network");
        showState("loading", "Switching network...");

        try {
          await switchChain(state.selectedWallet.provider, config.expectedChainId, {
            chainName: avalancheFujiChain.chainName,
            rpcUrls: avalancheFujiChain.rpcUrls,
            nativeCurrency: avalancheFujiChain.nativeCurrency,
            blockExplorerUrls: avalancheFujiChain.blockExplorerUrls,
          });

          // Verify the switch
          state.chainId = await getChainId(state.selectedWallet.provider);

          if (state.chainId !== config.expectedChainId) {
            throw new Error("Network switch failed - please try manually");
          }

          updateDiagnostics();

          // Proceed with login
          await performSiwaLogin(state.selectedWallet.provider);

        } catch (error) {
          handleWalletError(error);
        }
      }

      // Perform SIWA login
      async function performSiwaLogin(provider: EIP1193Provider) {
        if (!state.address) {
          throw new Error("No address available");
        }

        siwaLog.info("Starting SIWA login", { address: state.address });
        showState("loading", "Preparing login message...");

        try {
          // Prepare login
          siwaLog.debug("Calling prepareLogin");
          const prepared = await client.prepareLogin(state.address);
          siwaLog.debug("prepareLogin response", prepared);

          showState("loading", "Please sign the message in your wallet...");

          // Sign message
          siwaLog.debug("Requesting signature");
          const signature = await signMessage(provider, prepared.message, state.address);
          siwaLog.debug("Signature received", { signatureLength: signature.length });

          showState("loading", "Completing authentication...");

          // Complete login
          siwaLog.debug("Calling login");
          const result = await client.login(signature, state.address);
          siwaLog.info("Login successful", { principal: result.principal.toText() });

          // Update state
          state.isAuthenticated = true;
          state.principal = result.principal.toText();

          // Update UI
          if (principalDisplay) principalDisplay.textContent = result.principal.toText();
          if (addressDisplay) addressDisplay.textContent = result.address;

          showState("authenticated");
          updateDiagnostics();

        } catch (error) {
          siwaLog.error("SIWA login error", error);

          if (isRpcError(error) && error.code === RPC_ERRORS.USER_REJECTED) {
            showState("error", "Signature rejected by user");
          } else if (error instanceof Error) {
            showState("error", error.message);
          } else {
            showState("error", "Login failed");
          }
        }
      }

      // Logout handler
      async function handleLogout() {
        log.info("Logging out");
        try {
          await client.logout();
          state.address = null;
          state.selectedWallet = null;
          state.isAuthenticated = false;
          state.principal = null;
          state.chainId = null;

          if (cleanupProviderListeners) {
            cleanupProviderListeners();
            cleanupProviderListeners = null;
          }

          showState("wallets");
          updateDiagnostics();
        } catch (error) {
          log.error("Logout failed", error);
        }
      }

      // Check if already authenticated
      async function checkAuth() {
        siwaLog.debug("Checking existing authentication");
        try {
          if (await client.isAuthenticated()) {
            siwaLog.info("User is already authenticated");
            const principal = await client.getPrincipal();
            const address = await client.getAddress();

            state.isAuthenticated = true;
            state.principal = principal?.toText() || null;
            state.address = address || null;

            if (principalDisplay) principalDisplay.textContent = principal?.toText() || "";
            if (addressDisplay) addressDisplay.textContent = address || "";

            showState("authenticated");
          }
        } catch (error) {
          siwaLog.error("Auth check failed", error);
        }
      }

      // Export logs
      function handleExportLogs() {
        const logs = exportAllLogs();
        const blob = new Blob([logs], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `ic-siwa-logs-${new Date().toISOString().slice(0, 19).replace(/:/g, "-")}.json`;
        a.click();
        URL.revokeObjectURL(url);
        log.info("Logs exported");
      }

      // Event listeners
      walletConnectBtn?.addEventListener("click", handleWalletConnect);
      switchNetworkBtn?.addEventListener("click", handleNetworkSwitch);
      logoutBtn?.addEventListener("click", handleLogout);
      retryBtn?.addEventListener("click", () => {
        showState("wallets");
        updateDiagnostics();
      });
      dismissErrorBtn?.addEventListener("click", () => {
        showState("wallets");
        updateDiagnostics();
      });
      refreshDiagnostics?.addEventListener("click", updateDiagnostics);
      exportLogsBtn?.addEventListener("click", handleExportLogs);
      clearLogsBtn?.addEventListener("click", () => {
        [walletLog, siwaLog, networkLog, uiLog, eip6963Log, wcLog].forEach(l => l.clear());
        log.info("Logs cleared");
      });

      // Initialize
      async function init() {
        log.info("Initializing application");

        // Subscribe to wallet changes
        onWalletsChanged((wallets) => {
          log.debug("Wallets changed", { count: wallets.length });
          renderWalletButtons(wallets);
        });

        // Start wallet detection
        initWalletDetection();

        // Check existing auth
        await checkAuth();

        log.info("Initialization complete");
      }

      init();
    </script>
  </body>
</html>
