---
/**
 * IC-SIWA Test Canister - Enhanced Login Page
 *
 * Features:
 * - Multi-wallet detection (MetaMask, Core, Rabby, etc.)
 * - Network switching to Avalanche Fuji
 * - Locked wallet handling
 * - WalletConnect support
 * - Comprehensive diagnostics
 */
import "../styles/global.css";

// Configuration
const SIWA_PROVIDER_CANISTER_ID = import.meta.env.PUBLIC_SIWA_PROVIDER_CANISTER_ID || "be2us-64aaa-aaaaa-qaabq-cai";
const IC_HOST = import.meta.env.PUBLIC_IC_HOST || "http://127.0.0.1:5987";

// Expected chain configuration
const EXPECTED_CHAIN_ID = 43113; // Avalanche Fuji
const CHAIN_NAME = "Avalanche Fuji";
const RPC_URL = "https://api.avax-test.network/ext/bc/C/rpc";
const BLOCK_EXPLORER = "https://testnet.snowtrace.io";

const title = "IC-SIWA Test";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="navbar bg-base-100 shadow-lg">
      <div class="flex-1">
        <a class="btn btn-ghost text-xl">IC-SIWA Test</a>
      </div>
      <div class="flex-none gap-2">
        <span id="network-badge" class="badge badge-warning">Checking...</span>
        <span class="badge badge-outline">Development</span>
      </div>
    </div>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
      <div class="flex flex-col items-center justify-center">

        <!-- Login Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <h1 class="card-title text-2xl mb-2">Sign in with Avalanche</h1>
            <p class="text-base-content/70 mb-6">
              Test the IC-SIWA authentication flow
            </p>

            <!-- Wallet Selection -->
            <div id="wallet-selection" class="w-full">
              <p class="text-sm text-base-content/60 mb-3">Select a wallet to connect:</p>
              <div id="wallet-list" class="flex flex-col gap-2">
                <!-- Wallets will be injected here -->
                <div class="flex justify-center">
                  <span class="loading loading-dots loading-md"></span>
                </div>
              </div>
            </div>

            <!-- Loading State -->
            <div id="loading-state" class="hidden w-full">
              <div class="flex flex-col items-center">
                <span class="loading loading-spinner loading-lg"></span>
                <p id="loading-message" class="mt-2 text-base-content/70">Connecting...</p>
              </div>
            </div>

            <!-- Network Switch Required -->
            <div id="network-switch-state" class="hidden w-full">
              <div class="alert alert-warning mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <div>
                  <h3 class="font-bold">Wrong Network</h3>
                  <div class="text-xs">Current: <span id="current-chain-name">Unknown</span></div>
                  <div class="text-xs">Expected: {CHAIN_NAME} ({EXPECTED_CHAIN_ID})</div>
                </div>
              </div>
              <button id="switch-network-btn" class="btn btn-warning btn-wide">
                Switch to {CHAIN_NAME}
              </button>
            </div>

            <!-- Authenticated State -->
            <div id="authenticated-state" class="hidden w-full">
              <div class="alert alert-success mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <h3 class="font-bold">Connected!</h3>
                  <div class="text-xs break-all" id="principal-display"></div>
                </div>
              </div>

              <div class="stats shadow w-full mb-4">
                <div class="stat">
                  <div class="stat-title">Avalanche Address</div>
                  <div class="stat-value text-sm font-mono break-all" id="address-display"></div>
                </div>
              </div>

              <button id="logout-btn" class="btn btn-outline btn-wide">
                Disconnect
              </button>
            </div>

            <!-- Error State -->
            <div id="error-state" class="hidden w-full mt-4">
              <div class="alert alert-error">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <span id="error-message"></span>
                  <button id="retry-btn" class="btn btn-xs btn-ghost ml-2">Retry</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Configuration/Diagnostics Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl mt-4">
          <div class="card-body">
            <h2 class="card-title text-lg">
              Configuration & Diagnostics
              <button id="refresh-diagnostics" class="btn btn-xs btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </button>
            </h2>
            <div class="overflow-x-auto">
              <table class="table table-xs">
                <thead>
                  <tr><th colspan="2" class="text-primary">IC Configuration</th></tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="font-semibold">Provider Canister</td>
                    <td class="font-mono text-xs break-all">{SIWA_PROVIDER_CANISTER_ID}</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">IC Host</td>
                    <td class="font-mono text-xs">{IC_HOST}</td>
                  </tr>
                </tbody>
                <thead>
                  <tr><th colspan="2" class="text-primary pt-4">Avalanche Configuration</th></tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="font-semibold">Expected Chain ID</td>
                    <td class="font-mono text-xs">{EXPECTED_CHAIN_ID} ({CHAIN_NAME})</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">RPC URL</td>
                    <td class="font-mono text-xs break-all">{RPC_URL}</td>
                  </tr>
                </tbody>
                <thead>
                  <tr><th colspan="2" class="text-primary pt-4">Wallet Status</th></tr>
                </thead>
                <tbody id="wallet-diagnostics">
                  <tr>
                    <td class="font-semibold">Detected Wallets</td>
                    <td id="diag-wallets" class="font-mono text-xs">Checking...</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Current Chain ID</td>
                    <td id="diag-chain-id" class="font-mono text-xs">-</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Connected Address</td>
                    <td id="diag-address" class="font-mono text-xs break-all">-</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Wallet Unlocked</td>
                    <td id="diag-unlocked" class="font-mono text-xs">-</td>
                  </tr>
                  <tr>
                    <td class="font-semibold">Network Match</td>
                    <td id="diag-network-match" class="font-mono text-xs">-</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Help Card -->
        <div class="card w-full max-w-md bg-base-100 shadow-xl mt-4">
          <div class="collapse collapse-arrow">
            <input type="checkbox" />
            <div class="collapse-title font-medium">
              Troubleshooting
            </div>
            <div class="collapse-content text-sm">
              <ul class="list-disc pl-4 space-y-2">
                <li><strong>No wallets detected:</strong> Install MetaMask, Core Wallet, or Rabby</li>
                <li><strong>Wrong network:</strong> Click "Switch Network" or manually add Avalanche Fuji</li>
                <li><strong>Wallet locked:</strong> Unlock your wallet and refresh</li>
                <li><strong>Using Anvil fork:</strong> Ensure Anvil is forked from Fuji (chain ID 43113)</li>
                <li><strong>Connection refused:</strong> Check IC replica is running on {IC_HOST}</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer footer-center p-4 bg-base-300 text-base-content mt-8">
      <div>
        <p>IC-SIWA Test Canister - For development use only</p>
      </div>
    </footer>

    <!-- Hidden config for JS -->
    <div id="config"
      data-canister-id={SIWA_PROVIDER_CANISTER_ID}
      data-host={IC_HOST}
      data-expected-chain-id={EXPECTED_CHAIN_ID}
      data-chain-name={CHAIN_NAME}
      data-rpc-url={RPC_URL}
      data-block-explorer={BLOCK_EXPLORER}
      class="hidden"
    ></div>

    <script>
      import { SiwaClient } from "ic-siwa";

      // Types
      interface DetectedWallet {
        name: string;
        icon: string;
        provider: any;
        rdns?: string;
      }

      interface WalletState {
        selectedWallet: DetectedWallet | null;
        address: string | null;
        chainId: number | null;
        isUnlocked: boolean;
      }

      // Get configuration
      const configEl = document.getElementById("config");
      const config = {
        canisterId: configEl?.dataset.canisterId || "",
        host: configEl?.dataset.host || "https://ic0.app",
        expectedChainId: parseInt(configEl?.dataset.expectedChainId || "43113"),
        chainName: configEl?.dataset.chainName || "Avalanche Fuji",
        rpcUrl: configEl?.dataset.rpcUrl || "",
        blockExplorer: configEl?.dataset.blockExplorer || "",
      };

      // Avalanche chain config for adding network
      const avalancheFujiChain = {
        chainId: `0x${config.expectedChainId.toString(16)}`,
        chainName: config.chainName,
        nativeCurrency: {
          name: "AVAX",
          symbol: "AVAX",
          decimals: 18,
        },
        rpcUrls: [config.rpcUrl],
        blockExplorerUrls: [config.blockExplorer],
      };

      // State
      const state: WalletState = {
        selectedWallet: null,
        address: null,
        chainId: null,
        isUnlocked: false,
      };

      // UI Elements
      const walletSelection = document.getElementById("wallet-selection");
      const walletList = document.getElementById("wallet-list");
      const loadingState = document.getElementById("loading-state");
      const loadingMessage = document.getElementById("loading-message");
      const networkSwitchState = document.getElementById("network-switch-state");
      const authenticatedState = document.getElementById("authenticated-state");
      const errorState = document.getElementById("error-state");
      const principalDisplay = document.getElementById("principal-display");
      const addressDisplay = document.getElementById("address-display");
      const errorMessage = document.getElementById("error-message");
      const logoutBtn = document.getElementById("logout-btn");
      const switchNetworkBtn = document.getElementById("switch-network-btn");
      const retryBtn = document.getElementById("retry-btn");
      const networkBadge = document.getElementById("network-badge");
      const currentChainName = document.getElementById("current-chain-name");
      const refreshDiagnostics = document.getElementById("refresh-diagnostics");

      // Diagnostics elements
      const diagWallets = document.getElementById("diag-wallets");
      const diagChainId = document.getElementById("diag-chain-id");
      const diagAddress = document.getElementById("diag-address");
      const diagUnlocked = document.getElementById("diag-unlocked");
      const diagNetworkMatch = document.getElementById("diag-network-match");

      // Create SIWA client
      const client = new SiwaClient({ canisterId: config.canisterId, host: config.host });

      // Wallet icons (inline SVG data)
      const walletIcons: Record<string, string> = {
        metamask: `<svg viewBox="0 0 35 33" class="w-6 h-6"><path d="M32.958 1l-13.134 9.718 2.442-5.727z" fill="#E17726"/><path d="M2.663 1l13.017 9.809-2.325-5.818zm24.324 22.533l-3.507 5.36 7.505 2.067 2.155-7.318zm-26.85.109l2.142 7.318 7.493-2.067-3.507-5.36z" fill="#E27625"/></svg>`,
        coinbase: `<svg viewBox="0 0 40 40" class="w-6 h-6"><circle cx="20" cy="20" r="20" fill="#0052FF"/><path d="M20 8c6.627 0 12 5.373 12 12s-5.373 12-12 12S8 26.627 8 20 13.373 8 20 8z" fill="#fff"/><path d="M17 17h6v6h-6z" fill="#0052FF"/></svg>`,
        core: `<svg viewBox="0 0 40 40" class="w-6 h-6"><rect width="40" height="40" rx="8" fill="#000"/><path d="M20 8l10 12-10 12-10-12z" fill="#fff"/></svg>`,
        rabby: `<svg viewBox="0 0 40 40" class="w-6 h-6"><circle cx="20" cy="20" r="20" fill="#8697FF"/><path d="M12 16c0-4.4 3.6-8 8-8s8 3.6 8 8v8c0 4.4-3.6 8-8 8s-8-3.6-8-8v-8z" fill="#fff"/></svg>`,
        default: `<svg viewBox="0 0 40 40" class="w-6 h-6"><rect width="40" height="40" rx="8" fill="#6B7280"/><path d="M20 12v16M12 20h16" stroke="#fff" stroke-width="2"/></svg>`,
        walletconnect: `<svg viewBox="0 0 40 40" class="w-6 h-6"><rect width="40" height="40" rx="8" fill="#3B99FC"/><path d="M12 16.5c4.4-4.4 11.6-4.4 16 0l.5.5-1.5 1.5-.3-.3c-3.5-3.5-9.3-3.5-12.8 0l-.4.4-1.5-1.5zm19.8 3.7l1.7 1.7-7.8 7.8-5.5-5.5 1.5-1.5 4 4 6.1-6.5zm-23.6 0l6.1 6.5 4-4 1.5 1.5-5.5 5.5-7.8-7.8 1.7-1.7z" fill="#fff"/></svg>`,
      };

      // Detect all injected wallets
      function detectWallets(): DetectedWallet[] {
        const wallets: DetectedWallet[] = [];
        const win = window as any;

        // Check for EIP-6963 providers (modern standard)
        if (win.ethereum?.providers?.length) {
          for (const provider of win.ethereum.providers) {
            const name = provider.isMetaMask ? "MetaMask" :
                        provider.isCoinbaseWallet ? "Coinbase" :
                        provider.isRabby ? "Rabby" :
                        provider.isCore ? "Core" : "Unknown Wallet";
            const iconKey = name.toLowerCase().replace(" ", "");
            wallets.push({
              name,
              icon: walletIcons[iconKey] || walletIcons.default,
              provider,
            });
          }
        } else if (win.ethereum) {
          // Single provider
          const provider = win.ethereum;
          let name = "Browser Wallet";
          if (provider.isMetaMask) name = "MetaMask";
          else if (provider.isCoinbaseWallet) name = "Coinbase Wallet";
          else if (provider.isRabby) name = "Rabby";
          else if (provider.isCore || provider.isAvalanche) name = "Core";

          const iconKey = name.toLowerCase().replace(" ", "").replace("wallet", "");
          wallets.push({
            name,
            icon: walletIcons[iconKey] || walletIcons.default,
            provider,
          });
        }

        // Check for specific wallet extensions
        if (win.avalanche && !wallets.some(w => w.name === "Core")) {
          wallets.push({
            name: "Core",
            icon: walletIcons.core,
            provider: win.avalanche,
          });
        }

        // Add WalletConnect option (always available)
        wallets.push({
          name: "WalletConnect",
          icon: walletIcons.walletconnect,
          provider: null, // Will be initialized on click
          rdns: "walletconnect",
        });

        return wallets;
      }

      // Get wallet icon by name
      function getWalletIcon(name: string): string {
        const key = name.toLowerCase().replace(" ", "").replace("wallet", "");
        return walletIcons[key] || walletIcons.default;
      }

      // Update UI state
      function showState(stateName: "wallets" | "loading" | "network-switch" | "authenticated" | "error", message?: string) {
        walletSelection?.classList.toggle("hidden", stateName !== "wallets");
        loadingState?.classList.toggle("hidden", stateName !== "loading");
        networkSwitchState?.classList.toggle("hidden", stateName !== "network-switch");
        authenticatedState?.classList.toggle("hidden", stateName !== "authenticated");
        errorState?.classList.toggle("hidden", stateName !== "error");

        if (stateName === "loading" && loadingMessage && message) {
          loadingMessage.textContent = message;
        }
        if (stateName === "error" && errorMessage && message) {
          errorMessage.textContent = message;
        }
      }

      // Update network badge
      function updateNetworkBadge(chainId: number | null) {
        if (!networkBadge) return;

        if (chainId === null) {
          networkBadge.className = "badge badge-warning";
          networkBadge.textContent = "No Wallet";
        } else if (chainId === config.expectedChainId) {
          networkBadge.className = "badge badge-success";
          networkBadge.textContent = config.chainName;
        } else {
          networkBadge.className = "badge badge-error";
          networkBadge.textContent = `Chain ${chainId}`;
        }
      }

      // Update diagnostics
      async function updateDiagnostics() {
        const wallets = detectWallets();

        if (diagWallets) {
          const walletNames = wallets.filter(w => w.rdns !== "walletconnect").map(w => w.name);
          diagWallets.textContent = walletNames.length > 0 ? walletNames.join(", ") : "None";
        }

        if (state.selectedWallet?.provider) {
          try {
            const chainId = await state.selectedWallet.provider.request({ method: "eth_chainId" });
            state.chainId = parseInt(chainId, 16);
            if (diagChainId) diagChainId.textContent = `${state.chainId} (0x${state.chainId.toString(16)})`;

            const accounts = await state.selectedWallet.provider.request({ method: "eth_accounts" });
            state.address = accounts[0] || null;
            state.isUnlocked = accounts.length > 0;

            if (diagAddress) diagAddress.textContent = state.address || "Not connected";
            if (diagUnlocked) {
              diagUnlocked.textContent = state.isUnlocked ? "Yes" : "No (locked)";
              diagUnlocked.className = `font-mono text-xs ${state.isUnlocked ? "text-success" : "text-warning"}`;
            }
            if (diagNetworkMatch) {
              const match = state.chainId === config.expectedChainId;
              diagNetworkMatch.textContent = match ? "Yes" : "No";
              diagNetworkMatch.className = `font-mono text-xs ${match ? "text-success" : "text-error"}`;
            }

            updateNetworkBadge(state.chainId);
          } catch (e) {
            console.error("Diagnostics error:", e);
          }
        } else {
          if (diagChainId) diagChainId.textContent = "-";
          if (diagAddress) diagAddress.textContent = "-";
          if (diagUnlocked) diagUnlocked.textContent = "-";
          if (diagNetworkMatch) diagNetworkMatch.textContent = "-";
          updateNetworkBadge(null);
        }
      }

      // Render wallet buttons
      function renderWalletButtons() {
        if (!walletList) return;

        const wallets = detectWallets();

        if (wallets.length === 0) {
          walletList.innerHTML = `
            <div class="alert alert-warning">
              <span>No wallets detected. Please install MetaMask, Core, or another EVM wallet.</span>
            </div>
          `;
          return;
        }

        walletList.innerHTML = wallets.map(wallet => `
          <button class="btn btn-outline btn-block justify-start gap-3 wallet-btn" data-wallet="${wallet.name}">
            ${wallet.icon}
            <span>${wallet.name}</span>
            ${wallet.rdns === "walletconnect" ? '<span class="badge badge-xs">QR</span>' : ''}
          </button>
        `).join("");

        // Add click handlers
        document.querySelectorAll(".wallet-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const walletName = btn.getAttribute("data-wallet");
            const wallet = wallets.find(w => w.name === walletName);
            if (wallet) handleWalletSelect(wallet);
          });
        });

        updateDiagnostics();
      }

      // Handle wallet selection
      async function handleWalletSelect(wallet: DetectedWallet) {
        state.selectedWallet = wallet;
        showState("loading", `Connecting to ${wallet.name}...`);

        try {
          let provider = wallet.provider;

          // Initialize WalletConnect if selected
          if (wallet.rdns === "walletconnect") {
            showState("loading", "Initializing WalletConnect...");
            const { EthereumProvider } = await import("@walletconnect/ethereum-provider");

            provider = await EthereumProvider.init({
              projectId: "demo-project-id", // Replace with real project ID for production
              chains: [config.expectedChainId],
              showQrModal: true,
              qrModalOptions: {
                themeMode: "dark" as const,
              },
            });

            await provider.connect();
            state.selectedWallet = { ...wallet, provider };
          }

          if (!provider) {
            throw new Error("No provider available");
          }

          // Check if wallet is unlocked by requesting accounts
          showState("loading", "Checking wallet status...");
          let accounts: string[];
          try {
            accounts = await provider.request({ method: "eth_requestAccounts" });
          } catch (e: any) {
            if (e.code === 4001) {
              throw new Error("Connection rejected by user");
            }
            if (e.code === -32002) {
              throw new Error("Please unlock your wallet and try again");
            }
            throw e;
          }

          if (!accounts || accounts.length === 0) {
            throw new Error("No accounts available. Please unlock your wallet.");
          }

          state.address = accounts[0];
          state.isUnlocked = true;

          // Check chain ID
          showState("loading", "Checking network...");
          const chainIdHex = await provider.request({ method: "eth_chainId" });
          state.chainId = parseInt(chainIdHex, 16);

          await updateDiagnostics();

          // If wrong network, show switch prompt
          if (state.chainId !== config.expectedChainId) {
            if (currentChainName) currentChainName.textContent = `Chain ${state.chainId}`;
            showState("network-switch");
            return;
          }

          // Proceed with SIWA login
          await performSiwaLogin(provider);

        } catch (e: any) {
          console.error("Wallet connection error:", e);
          showState("error", e?.message || "Failed to connect wallet");
          await updateDiagnostics();
        }
      }

      // Switch network
      async function handleNetworkSwitch() {
        if (!state.selectedWallet?.provider) {
          showState("error", "No wallet connected");
          return;
        }

        showState("loading", "Switching network...");

        try {
          const provider = state.selectedWallet.provider;

          try {
            // Try to switch to the network
            await provider.request({
              method: "wallet_switchEthereumChain",
              params: [{ chainId: `0x${config.expectedChainId.toString(16)}` }],
            });
          } catch (switchError: any) {
            // If the network doesn't exist, add it
            if (switchError.code === 4902) {
              await provider.request({
                method: "wallet_addEthereumChain",
                params: [avalancheFujiChain],
              });
            } else {
              throw switchError;
            }
          }

          // Verify the switch
          const newChainId = await provider.request({ method: "eth_chainId" });
          state.chainId = parseInt(newChainId, 16);

          if (state.chainId !== config.expectedChainId) {
            throw new Error("Network switch failed");
          }

          await updateDiagnostics();

          // Proceed with login
          await performSiwaLogin(provider);

        } catch (e: any) {
          console.error("Network switch error:", e);
          showState("error", e?.message || "Failed to switch network");
        }
      }

      // Perform SIWA login
      async function performSiwaLogin(provider: any) {
        if (!state.address) {
          throw new Error("No address available");
        }

        showState("loading", "Preparing login message...");

        try {
          // Prepare login
          const prepared = await client.prepareLogin(state.address);

          showState("loading", "Please sign the message in your wallet...");

          // Sign message
          const signature = await provider.request({
            method: "personal_sign",
            params: [prepared.message, state.address],
          });

          showState("loading", "Completing authentication...");

          // Complete login
          const result = await client.login(signature, state.address);

          // Update UI
          if (principalDisplay) principalDisplay.textContent = result.principal.toText();
          if (addressDisplay) addressDisplay.textContent = result.address;

          showState("authenticated");
          await updateDiagnostics();

        } catch (e: any) {
          console.error("SIWA login error:", e);

          // Handle user rejection
          if (e.code === 4001) {
            showState("error", "Signature rejected by user");
          } else {
            showState("error", e?.message || "Login failed");
          }
        }
      }

      // Logout handler
      async function handleLogout() {
        try {
          await client.logout();
          state.address = null;
          state.selectedWallet = null;
          showState("wallets");
          await updateDiagnostics();
        } catch (e) {
          console.error("Logout failed:", e);
        }
      }

      // Check if already authenticated
      async function checkAuth() {
        try {
          if (await client.isAuthenticated()) {
            const principal = await client.getPrincipal();
            const address = await client.getAddress();

            if (principalDisplay) principalDisplay.textContent = principal?.toText() || "";
            if (addressDisplay) addressDisplay.textContent = address || "";

            showState("authenticated");
          }
        } catch (e) {
          console.error("Auth check failed:", e);
        }
      }

      // Event listeners
      switchNetworkBtn?.addEventListener("click", handleNetworkSwitch);
      logoutBtn?.addEventListener("click", handleLogout);
      retryBtn?.addEventListener("click", () => {
        showState("wallets");
        renderWalletButtons();
      });
      refreshDiagnostics?.addEventListener("click", updateDiagnostics);

      // Listen for account/chain changes
      function setupWalletListeners(provider: any) {
        provider.on?.("accountsChanged", (accounts: string[]) => {
          state.address = accounts[0] || null;
          state.isUnlocked = accounts.length > 0;
          updateDiagnostics();
          if (!state.isUnlocked) {
            showState("wallets");
            renderWalletButtons();
          }
        });

        provider.on?.("chainChanged", (chainId: string) => {
          state.chainId = parseInt(chainId, 16);
          updateDiagnostics();
          if (state.chainId !== config.expectedChainId) {
            showState("network-switch");
          }
        });
      }

      // Initialize
      async function init() {
        renderWalletButtons();
        await checkAuth();

        // Setup listeners for detected wallets
        const wallets = detectWallets();
        wallets.forEach(w => {
          if (w.provider) setupWalletListeners(w.provider);
        });
      }

      init();
    </script>
  </body>
</html>
